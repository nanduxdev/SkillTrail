{
	"name": "skill-trail",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"db:push": "drizzle-kit push",
		"db:seed": "bun db/seed.ts",
		"auth:generate": "bun x auth@latest generate --output ./db/schema/auth-schema.ts",
		"knip": "bunx --bun knip",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,jsonc,md,mdx,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@better-auth/drizzle-adapter": "^1.7.4",
		"@neon/config": "^1.4.2",
		"@neon/env": "^1.3.2",
		"@next-safe-action/adapter-better-auth": "^0.1.7",
		"better-auth": "^1.7.5",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^1.0.0-rc.4",
		"eslint": "^10.10.0",
		"eslint-config-next": "^16.3.5",
		"husky": "^9.1.7",
		"lenis": "^1.3.26",
		"lucide-react": "^1.45.0",
		"next": "16.3.4",
		"next-safe-action": "^8.7.3",
		"next-themes": "^0.4.6",
		"pg": "^8.23.0",
		"postgres": "^3.4.9",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "^5.7.0",
		"shadcn": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@fast-check/vitest": "^0.5.0",
		"@tailwindcss/postcss": "^4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^20",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "^1.0.0-rc.4",
		"eslint-config-prettier": "^10.1.8",
		"fast-check": "^4.10.1",
		"jsdom": "^30.1.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.7",
		"tailwindcss": "^4",
		"tsx": "^4.23.13",
		"typescript": "^5",
		"vitest": "^5.0.1"
	},
	"packageManager": "bun@1.3.14",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
