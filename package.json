		"prepare": "husky"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@better-auth/drizzle-adapter": "^1.7.4",
		"@neon/config": "^1.4.2",
		"@neon/env": "^1.3.2",
		"better-auth": "^1.7.4",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^1.0.0-rc.4",
		"husky": "^9.1.7",
		"lenis": "^1.3.26",
		"lucide-react": "^1.45.0",
		"next": "16.3.4",
		"pg": "^8.23.0",
		"postgres": "^3.4.9",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"shadcn": "^4.21.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"drizzle-kit": "^1.0.0-rc.4",
		"tailwindcss": "^4",
		"tsx": "^4.23.13",
		"typescript": "^5",
		"vitest": "^5.0.0"
	},
	"packageManager": "bun@1.3.14",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
